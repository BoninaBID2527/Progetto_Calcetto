{
  "name": "bonmatch-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST e Socket.IO di BONMATCH",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "jest --runInBand",
    "db:lite": "node dev/mongo-lite/cli.js",
    "migrate": "node src/scripts/migrate.js",
    "vapid": "node src/scripts/vapid.js"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tests/setup/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/setup/globalTeardown.js",
    "setupFiles": [
      "<rootDir>/tests/setup/env.js"
    ],
    "testTimeout": 20000
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "bson": "^6.10.4",
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
