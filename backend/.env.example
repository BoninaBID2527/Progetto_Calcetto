# Copia questo file in ".env" e cambia i valori. Non mettere mai segreti reali nel repository.

# Ambiente: development | test | production
NODE_ENV=development
PORT=4000

# MongoDB (con "docker compose up -d" dalla cartella principale)
MONGODB_URI=mongodb://127.0.0.1:27017/bonmatch
# Database separato usato SOLO dai test (il nome deve contenere "test")
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/bonmatch_test

# Segreto per firmare i token: una stringa lunga e casuale, obbligatoria in produzione
JWT_SECRET=cambia-questa-stringa-con-una-lunga-e-casuale
JWT_EXPIRES_IN=7d

# Origine del frontend (più origini separate da virgola)
CLIENT_ORIGIN=http://localhost:5173

# Programma periodico: promemoria, chiusura automatica, fine votazioni
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000

# Notifiche Web Push (facoltative). Genera le chiavi con: npm run vapid
# Senza queste chiavi le push sono spente e restano le notifiche in-app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tuo-indirizzo@example.com

# Limiti di frequenza (per IP). Impostare RATE_LIMIT_ENABLED=false solo nei test automatici.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API_MAX=600
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_REGISTER_MAX=20
# Dietro un proxy (nginx, Render, …) imposta il numero di proxy fidati, es. 1
# TRUST_PROXY=1
