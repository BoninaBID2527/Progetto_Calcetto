# Copia questo file in ".env" e cambia i valori. Non mettere mai segreti reali nel repository.

# Ambiente: development | test | production
NODE_ENV=development
PORT=4000

# MongoDB (con "docker compose up -d" dalla cartella principale)
MONGODB_URI=mongodb://127.0.0.1:27017/bonmatch
# Database separato usato SOLO dai test (il nome deve contenere "test")
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/bonmatch_test

# Segreto per firmare i token: una stringa lunga e casuale, obbligatoria in produzione
JWT_SECRET=cambia-questa-stringa-con-una-lunga-e-casuale
JWT_EXPIRES_IN=7d

# Origine del frontend (più origini separate da virgola)
CLIENT_ORIGIN=http://localhost:5173

# Programma periodico: promemoria, chiusura automatica, fine votazioni
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000
